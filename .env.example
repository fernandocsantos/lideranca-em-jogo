# Copie para .env e preencha. NUNCA versione o .env. As chaves ficam só no servidor.

# Anthropic — usada pelo orquestrador (SDK oficial) e repassada ao MiroFish
ANTHROPIC_API_KEY=sk-ant-...

# Zep Cloud — memória/grafo do MiroFish (plano gratuito atende o protótipo): https://app.getzep.com/
ZEP_API_KEY=z_...

# Chave interna entre o MiroFish e o proxy LiteLLM. Gere com:  openssl rand -hex 32  (prefixe com sk-)
LITELLM_MASTER_KEY=sk-troque-por-uma-chave-aleatoria

# MiroFish (opcional)
# MIROFISH_LLM_MODEL=claude-haiku-5-5
# MIROFISH_DESATIVADO=true                                # força o modo de contingência

# Painel do facilitador (/facilitador) — escolha um código forte
FACILITADOR_CODIGO=troque-este-codigo

# Modo demonstração sem custo (respostas fixas, sem chamar a Anthropic)
# LLM_FALSO=true
